pub struct ModelRunner {
    pub original_model:
        RunnableModel<TypedFact, Box<dyn TypedOp>, Graph<TypedFact, Box<dyn TypedOp>>>,
    pub primary_model:
        RunnableModel<TypedFact, Box<dyn TypedOp>, Graph<TypedFact, Box<dyn TypedOp>>>,
    pub secondary_model:
        RunnableModel<TypedFact, Box<dyn TypedOp>, Graph<TypedFact, Box<dyn TypedOp>>>,
    // pub primary_output_labels: Vec<OutputLabel>,
    // pub secondary_output_labels: Vec<OutputLabel>,
    // pub randomness: Vec<f32>,
}

impl ModelRunner {
    pub fn new<P: AsRef<Path>>(model_dir: P) -> anyhow::Result<Self> {
        let model_dir = model_dir.as_ref();
        let original_path = model_dir.join("original_model.onnx");
        let primary_path = model_dir.join("primary_model.onnx");
        let secondary_path = model_dir.join("secondary_model.onnx");
        // let meta_path = model_dir.join("meta.json");

        // Load ONNX models
        let original_model = tract_onnx::onnx()
            .model_for_path(&original_path)?
            .into_typed()?
            .into_optimized()?
            .into_runnable()?;
        let primary_model = tract_onnx::onnx()
            .model_for_path(&primary_path)?
            .into_typed()?
            .into_optimized()?
            .into_runnable()?;
        let secondary_model = tract_onnx::onnx()
            .model_for_path(&secondary_path)?
            .into_typed()?
            .into_optimized()?
            .into_runnable()?;

        // Load and parse meta.json
        // let meta_str = fs::read_to_string(&meta_path)?;
        // let config: ModelConfig = serde_json::from_str(&meta_str)?;

        // // Generate randomness
        // let randomness: Vec<f32> = (0..config.num_random_values)
        //     .map(|_| rand::random::<f32>())
        //     .collect();

        Ok(Self {
            original_model,
            primary_model,
            secondary_model,
            // primary_output_labels: config.primary_output_labels,
            // secondary_output_labels: config.secondary_output_labels,
            // randomness,
        })
    }

    fn random_input_for_model(model: &Model) -> anyhow::Result<Vec<Tensor>> {
        let input_outlets = model.model().input_outlets()?;
        let mut inputs = Vec::new();

        for input_fact in input_outlets {
            let fact = model.model().outlet_fact(*input_fact)?;
            let shape: Vec<usize> = fact.shape.as_concrete().unwrap().to_vec();
            let data = match fact.datum_type {
                DatumType::F32 => Array::random(shape, Uniform::new(0.0f32, 1.0f32)).into_tensor(),
                DatumType::F64 => Array::random(shape, Uniform::new(0.0f64, 1.0f64)).into_tensor(),
                DatumType::I64 => Array::random(shape, Uniform::new(0i64, 1i64)).into_tensor(),
                _ => panic!("Unsupported input type: {:?}", fact.datum_type),
            };
            inputs.push(data);
        }

        Ok(inputs)
    }

    pub fn run_model(model: &Model) {
        let input_tensors = Self::random_input_for_model(model).expect("random input failed");

        // Create input map with proper names
        let input_names = model.model().input_outlets().unwrap();
        let mut input_map = std::collections::HashMap::new();
        for (outlet, tensor) in input_names.iter().zip(input_tensors.iter()) {
            let name = model.model().node(outlet.node).name.clone();
            input_map.insert(name, tensor.clone());
        }

        // Prepare inputs in model order
        let mut tv_inputs = tvec![];
        for outlet in input_names {
            let name = model.model().node(outlet.node).name.clone();
            let tensor = input_map.get(&name).expect("missing input");
            tv_inputs.push(tensor.clone().into_tvalue());
        }

        let _ = model.run(tv_inputs).expect("model run failed");
    }

    pub fn run_native_inference(&self) {
        Self::run_model(&self.original_model);
    }

    pub fn run_inflated_inference(&self) {
        Self::run_model(&self.primary_model);
        Self::run_model(&self.secondary_model);
    }

